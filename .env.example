# StudyFlow AI — Environment Configuration Template
# Copy this file to .env and configure your variables

PORT=3000

# Comma-separated registration passcodes; set unique values locally.
FACULTY_PASSCODES=replace-with-a-private-faculty-passcode,replace-with-a-private-officer-passcode

# Exact browser origins allowed to call this server, comma-separated.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Groq AI Dynamic Coding Assessment & Strategic Insights
# Obtain a free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
